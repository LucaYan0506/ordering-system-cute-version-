# Django production example. Set these in the hosting provider, not in Git.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=your-domain.example
DJANGO_CORS_ALLOWED_ORIGINS=https://your-frontend.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-frontend.example

# Optional local demo account password. Never use this for production accounts.
DEMO_PASSWORD=replace-for-local-development

# Vite build-time API URL.
VITE_API_URL=https://your-api.example/api
